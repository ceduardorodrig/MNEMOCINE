# ── Banco de Dados ─────────────────────────────────
DB_PASSWORD=changeme
UMAMI_DB_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# ── StênioBOT ──────────────────────────────────────
DATABASE_URL=postgresql://stenio_user:{{DB_PASSWORD}}@db:5432/stenio_db
VALKEY_URL=redis://valkey:6379/0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://{{TAILSCALE_FUNNEL_DOMAIN}}/api/auth/callback
STENIOBOT_OWNER_EMAIL=admin@example.com
SECRET_KEY=
SECURE_COOKIES=true
ALLOWED_WS_ORIGINS=https://{{TAILSCALE_FUNNEL_DOMAIN}}
